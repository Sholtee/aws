doctype html
html
  head
    meta(charset="utf-8")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="viewport" content="width=device-width,initial-scale=1.0")
    :style login.sass
body
  script
    include login.js
  .card
    .head
      .title Sign in
      .details
        if !emailAddress
          | Please enter your email address to sign in
        else
          | Enter the login code we sent to&#32;
          b=emailAddress
    .body
      .input-holder(data-error=validationError)
        input#input(type="text" value=previousValue placeholder=!emailAddress ? "Email address" : "Login code")
    .foot
      button#next-button Next