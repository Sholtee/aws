extends _layout

block head
  :style login.sass
block body
  script
    include login.js
block card-title
  | Sign in
block card-details
  if !emailAddress
    | Please enter your email address to sign in
  else
    | Enter the login code we sent to&#32;
    b=emailAddress
block card-body
  .content
    .input-holder(data-error=validationError)
      input#input(type="text" value=previousValue placeholder=!emailAddress ? "Email address" : "Login code")
  .button-holder
    button#next-button Next